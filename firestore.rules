rules_version = '2';

// 營地分帳本的權限規則
// - 帳號白名單（allow/{email}）：只有清單上的 Google 帳號可以使用，其他登入者什麼都讀寫不到；
//   每個人只查得到自己的那一筆，看不到別人的 Email；只有管理者可以新增、移除
// - 露營（trips）：只有白名單的人可以建立；成員可以讀取，只有建立者可以修改設定；
//   成員可以選自己是哪一組（memberGroups 裡自己的那一格）；
//   知道露營 ID（邀請連結）的登入者可以讀取並把自己加入成員
// - 花費（expenses）：只有成員看得到；只能修改或刪除自己記的，露營建立者可以修改全部
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 可以建立露營的人（Firebase Auth UID），要和 app.js 的 CREATORS 一致
    function isCreator() {
      return signedIn() && request.auth.uid in ['K9pYZJfk12bjxNbng3OR14mtbs12'];
    }
    // 已驗證的 Google Email（小寫），用來對照白名單
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // 在白名單上：管理者一定可以，避免把自己鎖在外面
    function allowed() {
      return isCreator()
        || (signedIn() && request.auth.token.email is string && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/allow/$(myEmail())));
    }
    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    function isMember(tripId) {
      return allowed() && request.auth.uid in tripData(tripId).members;
    }
    function isTripOwner(tripId) {
      return signedIn() && tripData(tripId).ownerUid == request.auth.uid;
    }
    function validSettings(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.days is int && d.days >= 1 && d.days <= 7
        && d.groups is list && d.groups.size() <= 20
        && d.meals is list
        // 已結清的時間（毫秒），沒結清是 null 或不存在
        && (!('settledAt' in d) || d.settledAt == null || d.settledAt is int)
        && (!('memberGroups' in d) || d.memberGroups is map);
    }
    // 成員自己選的組別：{g: 組別 ID, name: 顯示名稱}
    function validBinding(b) {
      return b is map && b.keys().hasOnly(['g', 'name'])
        && b.g is string && b.g.size() <= 40
        && b.name is string && b.name.size() <= 60;
    }
    function validExpense(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount < 10000000
        && d.createdBy is string;
    }

    match /allow/{email} {
      // 查自己有沒有權限：只能讀自己 Email 的那一筆
      allow get: if isCreator()
        || (signedIn() && request.auth.token.email is string && request.auth.token.email_verified == true
          && email == myEmail());
      allow list: if isCreator();
      // Email 一律存小寫；note 是給管理者看的備註（例如名字）
      allow create, update: if isCreator() && email == email.lower() && email.size() <= 254
        && request.resource.data.keys().hasOnly(['note', 'addedAt'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 40
        && request.resource.data.addedAt is int;
      allow delete: if isCreator();
    }

    match /trips/{tripId} {
      // 單筆讀取：拿到邀請連結（露營 ID）的登入者可以看到露營名稱，決定要不要加入
      allow get: if allowed();
      // 清單查詢：只能查自己是成員的露營
      allow list: if allowed() && request.auth.uid in resource.data.members;

      allow create: if isCreator()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && validSettings(request.resource.data);

      allow update: if allowed() && (
        // 建立者修改設定：不能動建立者、成員名單和建立時間
        (resource.data.ownerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'members', 'createdAt'])
          && validSettings(request.resource.data))
        ||
        // 非成員透過邀請連結加入：只能把自己加到成員名單最後面
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
        ||
        // 成員選自己是哪一組：只能改 memberGroups 裡自己的那一格
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberGroups'])
          && request.resource.data.memberGroups.diff(resource.data.get('memberGroups', {})).affectedKeys().hasOnly([request.auth.uid])
          && validBinding(request.resource.data.memberGroups[request.auth.uid]))
      );

      allow delete: if allowed() && resource.data.ownerUid == request.auth.uid;

      match /expenses/{expenseId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && request.resource.data.createdBy == request.auth.uid
          && validExpense(request.resource.data);
        allow update: if isMember(tripId)
          && (resource.data.createdBy == request.auth.uid || isTripOwner(tripId))
          && request.resource.data.createdBy == resource.data.createdBy
          && validExpense(request.resource.data);
        allow delete: if isMember(tripId)
          && (resource.data.createdBy == request.auth.uid || isTripOwner(tripId));
      }
    }
  }
}
